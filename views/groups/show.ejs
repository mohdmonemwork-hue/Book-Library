<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= group.name %></title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/groups/show.css">
  </head>
  <body>
    <%- include('../partials/navbar') %>

    <div class="page">
 <h1><%= group.name %></h1>
 <p><%= group.description %></p>



  <h2>Members</h2>
  <% if (group.members.length === 0) { %>
    <p>No members yet.</p>
        <% } %>

  <% for (let mem of group.members) { %>
      <div>
      <h3><%= mem.name %></h3>
    <% const memberBooks = books.filter(function(book) {
         return book.owner.toString() === mem._id.toString();
          }); %>

      <% if (memberBooks.length === 0) { %>
          <p>No books yet.</p>
  <% } %>

<% for (let book of memberBooks) { %>
        <div class="card mb-3 book-card" style="max-width: 540px;">
      <div class="row g-0">
        <div class="col-md-4">
            <% if (book.image) { %>
        <img src="<%= book.image %>" class="img-fluid rounded-start" alt="<%= book.title %>" />
 <% } %>
        </div>
        <div class="col-md-8">
          <div class="card-body">
      <h5 class="card-title">
        <a href="/books/<%= book._id %>"><%= book.title %></a>
      </h5>
      <p class="card-text"><%= book.author %></p>
      <p class="card-text"><small class="text-body-secondary">Status: <%= book.status %></small></p>
          </div>
        </div>
      </div>
    </div>
    <% } %>
   </div>
    <% } %>
</div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>