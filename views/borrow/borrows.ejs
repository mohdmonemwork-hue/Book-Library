<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Borrow Requests</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/borrow/borrow.css">
  </head>
  <body>
    <%- include('../partials/navbar') %>
    <div class="page">
    <h2>Requests for my books</h2>
    <% for (let r of Receive) { %>
        <div class="box">

        
        <p>
          <%= r.book.title %> - requested by
          <a href="/users/<%= r.requester._id %>"><%= r.requester.name %></a>
          - <%= r.status %>
        </p>

        <% if (r.status === "requested") { %>
          <form action="/borrow/<%= r._id %>/approve?_method=PUT" method="POST">
            <button>Approve</button>
          </form>
          <form action="/borrow/<%= r._id %>/reject?_method=PUT" method="POST">
            <button class="delete-btn">Reject</button>
          </form>
        <% } %>

        <% if (r.status === "approved") { %>
          <form action="/borrow/<%= r._id %>/return?_method=PUT" method="POST">
            <button>Mark as returned</button>
          </form>
        <% } %>
      </div>
    <% } %>

    <h2>My requests</h2>
    <% for (let r of request) { %>
      <div class="box">
      <p>
        <%= r.book.title %> - owner:
        <a href="/users/<%= r.owner._id %>"><%= r.owner.name %></a>
        - <%= r.status %>
      </p>
          </div>
      <% } %>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>