<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= book.title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/show.css">

  </head>
  <body>
    <%- include('./partials/navbar') %>
  <div class="page">
  <div class="book-details">

     <div class="book-img">
    <% if (book.image) { %>
      <img src="<%= book.image %>" alt="" width="400" />
    <% } %>
        </div>
<div class="book-info">
    <h1><%= book.title %> <% if (book.favorite) { %>❤️<% } %></h1>
    <p>Author: <%= book.author %></p>
      <p>Genre: <%= book.genre %></p>
    <p>ISBN: <%= book.isbn %></p>
      <p>Status: <%= book.status %></p>
    <p>Owner: <%= book.owner.username %></p>

    <% const isOwner = book.owner._id.toString() === user._id.toString(); %>

    <% if (isOwner || user.role === "super_admin") { %>
      <a href="/books/<%= book._id %>/edit">Edit</a>
      <form action="/books/<%= book._id %>?_method=DELETE" method="post">
        <button type="submit" class="delete-btn">Delete</button>
      </form>
    <% } %>

    <% if (!isOwner && book.status === "available") { %>
      <form action="/borrow" method="POST">
        <input type="hidden" name="bookId" value="<%= book._id %>" />
        <button>Request to borrow</button>
      </form>
    <% } %>

    </div>

  </div>
</div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>