<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
</head>
<body>
    <%- include('./partials/navbar') %>

    <h1>Welcome to my Website</h1>

  <% if (user) { %>
      <h2>My Favorite Books</h2>
     <% if (favoriteBooks.length === 0) { %>
       <p>You haven't marked any books as favorite yet.</p>
     <% } %>
 <% favoriteBooks.forEach(function(book) { %>
       <div>
         <% if (book.image) { %>
      <img src="<%= book.image %>" alt="photo" width="150" />
     <% } %>
        <h3><a href="/books/<%= book._id %>"><%= book.title %></a></h3>
    <p><%= book.author %></p>
    </div>
    <% }); %>
    <% } %>
</body>
</html>