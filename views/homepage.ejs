<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/homepage.css">
    <title>Home</title>
    
</head>
<body>
    <%- include('./partials/navbar') %>
<div class="page">
    <h1>Book Library website!</h1>

    <% if (user) { %>
 <h2>My Favorite Books</h2>
<% if (favoriteBooks.length === 0) { %>
<p>You haven't marked any books as favorite yet.</p>
<% } %>

 <div class="row g-1">
  <% for (let book of favoriteBooks) { %>
    <div class="col-6 col-sm-4 col-md-3 col-lg-2">
<div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden">
 <div class="ratio ratio-4x3">
      <% if (book.image) { %>
     <img src="<%= book.image %>" class="object-fit-cover" alt="<%= book.title %>">
       <% } %>
    </div>
        <div class="card-body">
        <h5 class="card-title fs-6 mb-1"><%= book.title %></h5>
      <p class="card-text text-muted small mb-3"><%= book.author %></p>
      <a href="/books/<%= book._id %>" class="btn btn-sm btn-outline-primary stretched-link">View</a>
        </div>
      </div>
    </div>
  


    <%}%>
</div>       
    






    
<% } else if(!user){ %>
    
    
    <h2>Welcome to the library website where you can build your library and join groups to see what your friends have and borrow from each other</h2>
    
    
    <%}%>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</div>
</body>
</html>