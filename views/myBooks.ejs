<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Books</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/myBooks.css">
  </head>
  <body>
  <%- include('./partials/navbar') %>
  <div class="page">
    <h1>My Books</h1>
<a href="/books/new" class="add-btn">Add a Book</a>
    <% for(let book of books) { %>
      <div>
        <div class="card mb-3 book-card" style="max-width: 540px;">
        <div class="row g-0">
          <div class="col-md-4">
        <% if (book.image) { %>
        <img src="<%= book.image %>" class="img-fluid rounded-start" alt="<%= book.title %>" />
  <% } %>
          </div>
          <div class="col-md-8">
            <div class="card-body">
  <h5 class="card-title"><a href="/books/<%= book._id %>"><%= book.title %></a> <% if (book.favorite) { %>❤️<% } %></h5>
        <p class="card-text"><%= book.author %></p>
     <p class="card-text"><small class="text-body-secondary">Status: <%= book.status %></small></p>
            </div>
          </div>
        </div>
      </div>
      </div>
 <% }; %>
 <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
 </div>
  </body>
</html>



