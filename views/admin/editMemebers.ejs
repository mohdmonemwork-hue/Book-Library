<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Manage <%= group.name %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/admin/editMembers.css">
  </head>
  <body>
    <%- include('../partials/navbar') %>

    <div class="page">
      <a href="/admin">← Back to dashboard</a>

      <h1><%= group.name %></h1>
      <p><%= group.description %></p>

      <h2>Members (<%= group.members.length %>)</h2>

      <% if (group.members.length === 0) { %>
        <p>No members yet.</p>
      <% } %>

      <% for (let member of group.members) { %>
        <div class="member">
          <p><%= member.username %> - <%= member.name %></p>

          <form action="/admin/groups/<%= group._id %>/members/<%= member._id %>?_method=DELETE" method="POST">
            <button type="submit" class="delete-btn">Remove</button>
          </form>
        </div>
      <% } %>

      <h2>Add Member</h2>
      <div class="form-box">
        <form action="/admin/groups/<%= group._id %>/members" method="POST">
          <label for="username">Username:</label>
          <input type="text" name="username" id="username" required />
          <button type="submit">Add</button>
        </form>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>