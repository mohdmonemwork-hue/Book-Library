<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard</title>
  </head>
  <body>
    <%- include('../partials/navbar') %>
    <H1>Admin Dash board</H1>

    <div>
      <h3>website stats</h3>
      <p>Users: <%= userCount %></p>
      <p>Groups: <%= groups.length %></p>
    </div>
    <form action="/admin/groups/new" method="GET">
      <Button>Create new Group </Button>
    </form>

        <h2>Groups</h2>
    

<% if (groups.length === 0) { %>
  <p>No groups yet.</p>
<% } else { %>
<% groups.forEach((group) => { %>
      <div class="group-card">
      <P><h5>group name:</h5><h2><%= group.name %></h2></P>
      <p><%= group.description %></p>
      <p>Members: <%= group.members.length %></p>

        
        <form action="/admin/groups/<%= group._id %>/edit" method="GET">
      <Button>Edit </Button>
    </form>
    <form action="/groups/<%= group._id %>" method="GET">
      <Button>Go to group</Button>
    </form>


        <form action="/admin/groups/<%= group._id %>?_method=DELETE" method="POST">
          <button type="submit">Delete</button>
        </form>
      </div>
    <% }) %>
  <% } %>
  </body>
</html>

  </body>
</html>
