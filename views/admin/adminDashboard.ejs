<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/admin/adminDashboard.css">
  </head>
  <body>
    <%- include('../partials/navbar') %>

    <div class="page">
      <h1>Admin Dashboard</h1>

      <h3>Website stats</h3>
      <div class="stats">
        <p>Users: <%= userCount %></p>
        <p>Groups: <%= groups.length %></p>
      </div>

      <h2>Groups</h2>
      <a href="/admin/groups/new" class="add-btn">Create new Group</a>

      <% if (groups.length === 0) { %>
        <p>No groups yet.</p>
      <% } %>

      <% for (let group of groups) { %>
        <div class="group-card">
          <h3><%= group.name %></h3>
          <p><%= group.description %></p>
          <p>Members: <%= group.members.length %></p>

          <a href="/admin/groups/<%= group._id %>/edit">Edit members</a> |
          <a href="/groups/<%= group._id %>">Go to group</a>

        <form action="/admin/groups/<%= group._id %>?_method=DELETE" method="POST">
      <button type="submit" class="delete-btn" onclick="return confirm('Delete this group?')">Delete</button>
      </form>
        </div>
      <% } %>

      <h2>Users</h2>
    <% for (let ur of users) { %>
     <div class="user-row">
      <p><%= ur.name %> (<%= ur.username %>)</p>

       <% if (ur.role !== "super_admin") { %>
    <form action="/admin/users/<%= ur._id %>?_method=DELETE" method="POST">
      <button type="submit" class="delete-btn" onclick="return confirm('Are you sure?')">Delete</button>
   </form>
     <% } %>
      </div>
      <% } %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>